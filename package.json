{
  "description": "JavaScript and TypeScript SDK for Gleap, an Intercom alternative with AI customer support, live chat, in-app bug reporting and customer feedback.",
  "name": "gleap",
  "version": "19.8.1",
  "main": "build/cjs/index.js",
  "module": "build/esm/index.mjs",
  "exports": {
    "import": "./build/esm/index.mjs",
    "require": "./build/cjs/index.js",
    "types": "./index.d.ts"
  },
  "types": "index.d.ts",
  "files": [
    "build/",
    "index.d.ts"
  ],
  "scripts": {
    "start": "webpack serve --env development",
    "build": "webpack",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "typecheck": "tsc --noEmit --strict --types node index.d.ts",
    "prepare": "(sh .githooks/install.sh 2>/dev/null || true) && npm run build",
    "trypublish": "npm publish || true",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GleapSDK/JavaScript-SDK.git"
  },
  "author": "Gleap <hello@gleap.io>",
  "homepage": "https://www.gleap.ai",
  "keywords": [
    "bug-reporting",
    "bug-reporting-tool",
    "customer-surveys",
    "surveys",
    "customer-feedback",
    "customer-feedback-sdk",
    "javascript-bug-reporting",
    "crash-reporting",
    "marketing-automation",
    "user-onboarding",
    "ai-support",
    "in-app-feedback",
    "intercom-alternative",
    "ai-customer-support",
    "live-chat",
    "sdk"
  ],
  "license": "MIT",
  "licenseFilename": "LICENSE",
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.23.9",
    "@babel/eslint-parser": "7.23.10",
    "@babel/plugin-transform-class-properties": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@node-minify/clean-css": "^8.0.6",
    "@node-minify/core": "^8.0.6",
    "@node-minify/csso": "^8.0.6",
    "@playwright/test": "^1.65.1",
    "babel-loader": "^9.1.3",
    "babel-preset-minify": "^0.5.2",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "file-loader": "^6.2.0",
    "jsdom": "^26.1.0",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^5.9.3",
    "uglify-js": "^3.17.4",
    "url-loader": "^4.1.1",
    "vitest": "^4.1.12",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.5",
    "@rrweb/packer": "^2.1.0",
    "@rrweb/record": "^2.1.0",
    "modern-screenshot": "4.7.0",
    "unique-selector": "^0.5.0"
  }
}
